PORT=3003

# Deepgram Nova-3 — transcription (keeps every retake verbatim; Whisper merges them)
DEEPGRAM_API_KEY=

# fal — the model that decides the cuts, via fal's OpenRouter proxy
FAL_KEY=
# Optional overrides for experiments (OpenRouter model IDs)
# ROUGHCUT_MODEL=anthropic/claude-fable-5.1
# ROUGHCUT_FALLBACK_MODEL=anthropic/claude-opus-5
# ROUGHCUT_EFFORT=low

# Supabase — private video-roughcut bucket + transcription cache (service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the Next.js app and the worker (required in production)
INTERNAL_API_KEY=

# Optional: ffmpeg binary (the Docker image installs it on PATH)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
